# Settings for running the API on your machine (uv run ...). Copy to backend/.env.
# Every setting is read from APP_* environment variables; see app/core/config.py.

APP_ENVIRONMENT=development

# The Compose database, published on localhost. Replace REPLACE_WITH_POSTGRES_PASSWORD with the
# POSTGRES_PASSWORD from the root .env.
APP_DATABASE_URL=postgresql+asyncpg://starter:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/starter

# Optional. Without it, sign-in rate limiting is disabled.
APP_REDIS_URL=redis://localhost:6379/0

APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=console
APP_SESSION_TTL_HOURS=168
APP_ALLOW_REGISTRATION=true
APP_LOGIN_ATTEMPTS_PER_WINDOW=10
APP_LOGIN_WINDOW_SECONDS=900

# Tests use their own database and Redis database, which they wipe.
APP_TEST_DATABASE_URL=postgresql+asyncpg://starter:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/starter_test
APP_TEST_REDIS_URL=redis://localhost:6379/15
