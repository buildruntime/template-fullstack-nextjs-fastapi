# Settings for Docker Compose (compose.yaml). Copy to .env and fill in the empty values.
# .env is ignored by Git. Never commit real credentials.

# Required. A password for the local PostgreSQL container, for example: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=starter
POSTGRES_DB=starter

# Ports on 127.0.0.1. Change them if something else on your machine uses them.
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# json for one JSON object per line, console for readable output.
APP_LOG_FORMAT=console
APP_ALLOW_REGISTRATION=true
