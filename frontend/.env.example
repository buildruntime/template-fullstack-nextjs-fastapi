# Settings for running the frontend on your machine (npm run dev). Copy to frontend/.env.local.

# Where the Next.js server reaches the API. Server-side only: never prefix it with NEXT_PUBLIC_.
API_URL=http://localhost:8000

# Session cookies are Secure in production builds. Set to false only when serving a production
# build over plain HTTP on a host other than localhost.
# SESSION_COOKIE_SECURE=true
